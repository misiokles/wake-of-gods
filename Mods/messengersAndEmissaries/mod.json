          "messageSingular",
          "messagePlural"
        ],
        "properties": {
          "messageSingular": {
            "type": "string"
          },
          "messagePlural": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "{Fire Wall} Has a ${val}% chance after a melee attack to create a Basic Wall of Fire (spell power 3) on and beside the surviving target."
    }

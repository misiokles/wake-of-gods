{
  "waterMagicMushroom": {
    "name": "Magic Water Mushroom",
    "handler": "configurable",
    "types": {
      "waterMagicMushroom": {
        "name": "Magic Water Mushroom",
        "description": "@wake-of-gods.mapobjects.magicmushrooms.dialog.water.description",
        "onVisitedMessage": "@wake-of-gods.mapobjects.magicmushrooms.dialog.water.visited",
        "visitMode": "bonus",
        "rmg": {
          "value": 2000,
          "rarity": 20,
          "zoneLimit": 1
        },
        "sounds": {
          "ambient": [
            "LOOPFAER"
          ],
          "visit": [
            "LUCK"
          ]
        },
        "rewards": [
          {
            "bonuses": [
              {
                "type": "MAGIC_SCHOOL_SKILL",
                "subtype": "water",
                "val": 3,
                "duration": "ONE_WEEK",
                "valueType": "AT_LEAST"
              }
            ],
            "message": "@wake-of-gods.mapobjects.magicmushrooms.dialog.water.reward",
            "limiter": {
              "noneOf": [
                {
                  "secondary": {
                    "waterMagic": 3
                  }
                }
              ]
            }
          }
        ],
        "templates": {
          "zobj008": {
            "animation": "mapObjects/zobj008.def",
            "mask": [
              "VVVV",
              "VVVV",
              "VVBV",
              "VVAV"
            ],
            "visitableFrom": [
              "---",
              "+++",
              "+++"
            ]
          }
        },
        "onEmptyMessage": "@wake-of-gods.mapobjects.magicmushrooms.dialog.water.expert",
        "notVisitedTooltip": "@wake-of-gods.mapobjects.magicmushrooms.dialog.water.available",
        "visitedTooltip": "@wake-of-gods.mapobjects.magicmushrooms.dialog.water.used"
      }
    }
  },
